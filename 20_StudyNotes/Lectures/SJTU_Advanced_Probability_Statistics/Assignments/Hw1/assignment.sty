\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{assignment}[2026/09/19 Minimal assignment handout style]

\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{dsfont}  % for \mathds{1} indicator function
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{needspace}
\RequirePackage[most]{tcolorbox}

% ---------- Page style ----------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}
\setlength{\headheight}{14pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}

% ---------- Assignment metadata ----------
\newcommand{\course}[1]{\def\assignmentcourse{#1}}
\newcommand{\term}[1]{\def\assignmentterm{#1}}
\newcommand{\assignment}[1]{\def\assignmentname{#1}}
\newcommand{\duedate}[1]{\def\assignmentdue{#1}}

\course{}
\term{}
\assignment{Assignment}
\duedate{}

% ---------- Title block ----------
\newcommand{\makeassignmenttitle}{%
  \begin{center}
    \vspace*{-0.35in}
    \ifdefempty{\assignmentcourse}{}{%
      {\small\bfseries \assignmentcourse%
      \ifdefempty{\assignmentterm}{}{\enspace\textperiodcentered\enspace\assignmentterm}\par}
      \vspace{0.45em}%
    }%
    {\LARGE\bfseries \assignmentname\par}
    \ifdefempty{\assignmentdue}{}{%
      \vspace{0.55em}
      {\normalsize Due: \assignmentdue\par}%
    }%
    \vspace{0.75em}
  \end{center}%
}

% ---------- Problems ----------
\newcounter{problem}
\NewDocumentEnvironment{problem}{O{}}{%
  \Needspace{4\baselineskip}%
  \refstepcounter{problem}%
  \par\addvspace{0.75\baselineskip}%
  \noindent\textbf{\theproblem.}%
  \ifstrempty{#1}{}{\ \textbf{[#1 points]}}%
  \hspace{0.35em}\ignorespaces
}{%
  \par\addvspace{0.15\baselineskip}%
}

\newcommand{\points}[1]{\textbf{[#1 points]}}

\newenvironment{subproblems}{%
  \begin{enumerate}[label=(\roman*),leftmargin=2.65em,labelsep=0.65em,itemsep=0.55em,topsep=0.55em,parsep=0pt]
}{%
  \end{enumerate}
}

% ---------- Solutions ----------
\newtcolorbox{solution}{%
  enhanced,
  colback=gray!12,
  colframe=gray!12,   % same as background => no visible border
  boxrule=0pt,
  sharp corners,
  left=0.8em,
  right=0.8em,
  top=0.6em,
  bottom=0.6em,
  before skip=0.7\baselineskip,
  after skip=0.4\baselineskip,
  breakable,
  fontupper=\normalfont,
  before upper={\textbf{Solution.}\hspace{0.6em}},
}

% A slightly tighter displayed-math spacing suits problem sheets.
\setlength{\abovedisplayskip}{0.55em}
\setlength{\belowdisplayskip}{0.55em}
\setlength{\abovedisplayshortskip}{0.35em}
\setlength{\belowdisplayshortskip}{0.35em}
